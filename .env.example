DATABASE_URL="postgresql://user:password@host:5432/schedule_db"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Defina "true" apenas se DATABASE_URL apontar para um banco fora da rede
# privada do provedor (ex.: Neon/Supabase, ou a External Database URL do
# Render acessada de fora do Render). Para a Internal Database URL do
# Render usada pelo próprio Web Service do Render, deixe em branco/ausente.
DATABASE_SSL=""

# URL do frontend em produção (usada no CORS). Múltiplas origens separadas por vírgula.
FRONTEND_URL="https://seu-frontend.vercel.app"
